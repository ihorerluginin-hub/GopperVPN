<?xml version="1.0" encoding="utf-8"?><!--
  Liquid Glass (iOS-стиль): блик на стеклянной карточке. Верхняя
  кромка светится (белый 12%), к середине стекло проясняется,
  у нижней кромки лёгкое затемнение — глубина линзы. Оверлей
  некликабельный, лежит поверх контента карточки.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#00FFFFFF"
                android:endColor="#14000000"
                android:startColor="#1FFFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
