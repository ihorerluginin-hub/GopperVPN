<?xml version="1.0" encoding="utf-8"?><!--
  Liquid Glass (iOS-стиль): объём стеклянной карточки. Верхняя
  кромка светится (белый 14%), к середине — ноль, у нижней кромки
  лёгкое внутреннее затемнение (чёрный 8%) — глубина линзы.
  Оверлей некликабельный, лежит поверх контента карточки.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#00FFFFFF"
                android:endColor="#14000000"
                android:startColor="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
