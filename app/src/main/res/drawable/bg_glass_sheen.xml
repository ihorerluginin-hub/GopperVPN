<?xml version="1.0" encoding="utf-8"?><!--
  Liquid Glass (iOS-стиль): мягкий блик на стеклянной карточке.
  Верхняя кромка слегка светится (белый 6%), к середине — ноль;
  тяжёлых пелен и затемнений нет. Оверлей некликабельный, лежит
  поверх контента карточки.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#00FFFFFF"
                android:startColor="#0FFFFFFF" />
        </shape>
    </item>
</layer-list>
