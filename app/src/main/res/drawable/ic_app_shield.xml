<?xml version="1.0" encoding="utf-8"?><!--
  Щит из иконки приложения. Пропорции взяты из make_icon.ps1 при
  side = 432 и нормированы на 268: щит занимает 0.62 и 0.66 side по
  ширине и высоте.

  Низ щита — два прямых ребра от боковых точек (268; 142,6) и
  (0; 142,6) к острию (134; 255), без промежуточных изгибов. Остриё
  ровно 100°: каждое ребро отклоняется от вертикали на 50°, значит
  Y = 142.6 + 134 / tan 50° = 255. У самого острия скругления нет,
  в пути для него идёт прямая L.

  Верхние и боковые углы сглажены квадратичными кривыми Q: радиус 30
  сверху и 22 по бокам, где вертикальный бок переходит в ребро к
  острию.

  Заливка плоская: #EFF4FF — среднее между белым и #DEE8FF из
  make_icon.ps1. Градиент внутри вектора требует aapt:attr и API 24, а
  minSdk у приложения 21, на Android 5 такой вектор не надувается.
  Тень щита не перенесена — на синей подложке иконки она была нужна, на
  цветном круге кнопки её не видно.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="268dp"
    android:height="268dp"
    android:viewportWidth="268"
    android:viewportHeight="268">

    <path
        android:fillColor="#EFF4FF"
        android:pathData="M0,30 Q0,0 30,0 L238,0 Q268,0 268,30 L268,120.6 Q268,142.6 251.1,156.7 L134,255 L16.9,156.7 Q0,142.6 0,120.6 Z" />

</vector>
