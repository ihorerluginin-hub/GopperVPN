<?xml version="1.0" encoding="utf-8"?><!--
  Щит из иконки приложения — тот же силуэт, что рисует make_icon.ps1.

  В make_icon.ps1 щит заливается градиентом от белого к #DEE8FF. Здесь
  заливка плоская, усреднённая между ними (#EFF4FF): градиент внутри
  вектора требует aapt:attr и API 24, а minSdk у приложения 21 — на
  Android 5 такой вектор не надувается. Разница на глаз незаметна.

  Тень под щитом тоже не перенесена: она была нужна только на синей
  подложке иконки, на цветном круге кнопки её не видно.

  Координаты — из make_icon.ps1 при side = 432, сдвинутые к левому
  верхнему углу щита и нормированные на 268: щит занимает 0.62 и 0.66
  side по ширине и высоте.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="268dp"
    android:height="268dp"
    android:viewportWidth="268"
    android:viewportHeight="268">

    <path
        android:fillColor="#EFF4FF"
        android:pathData="M0,0 L268,0 L268,142.6 L251.8,193.9 L219.6,233.8 L176.8,259.5 L134,268 L91.1,259.5 L48.2,233.8 L16.1,193.9 L0,142.6 Z" />

</vector>