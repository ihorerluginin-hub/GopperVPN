<?xml version="1.0" encoding="utf-8"?><!--
  Панель приложения с вертикальным градиентом: сверху colorPrimaryDark
  (сливается со статус-баром), книзу светлеет до colorPrimary.
  Цвета берутся из активной темы: «Гоппер» даёт свой фирменный
  градиент gopper_700 → gopper_500, остальные темы — свой оттенок.
  Раньше здесь были жёстко прописанные зелёные цвета, из-за которых
  тулбар оставался зелёным при любой выбранной теме.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:endColor="?attr/colorPrimary"
        android:startColor="?attr/colorPrimaryDark" />
</shape>
