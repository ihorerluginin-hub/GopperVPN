<?xml version="1.0" encoding="utf-8"?><!--
  Главный экран «Гоппер VPN».

  Кнопки подключения и быстрых действий — шапка списка
  (layout_main_header.xml, первый элемент аккордеона): едут вместе с
  карточками серверов ровно на палец, без анимаций; возвращаются
  только физической прокруткой до верха. Панель с названием и
  шестерёнкой закреплена (elevation 4dp).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ConfigurationFragment">

    <LinearLayout
        android:id="@+id/glow_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gopper_page_bg"
        android:orientation="vertical">

        <!-- Панель закреплена -->
        <include
            layout="@layout/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Список аккордеона: заголовок подписки, под ним её серверы,
             под ними — заголовок следующей подписки. Первым элементом
             идёт шапка с кнопками (layout_main_header.xml).

             Раньше здесь были вкладки подписок (TabLayout), строка
             действий текущей подписки и ViewPager2 с отдельным
             фрагментом на каждую подписку. Теперь всё это один
             RecyclerView. Тап по заголовку сворачивает подписку
             до одной строки.

             Раньше здесь же была карточка статуса с состоянием
             подключения и выбранным сервером. Она удалена: эти данные
             показывает нижняя панель StatsBar, а дубль под кнопками
             только занимал место. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/accordion_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbarSize="0dp"
            tools:listitem="@layout/layout_accordion_header" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
