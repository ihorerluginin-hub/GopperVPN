<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_domain_24"
            app:key="localAddress"
            app:title="@string/wireguard_local_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="privateKey"
            app:title="@string/ssh_private_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="peerPublicKey"
            app:title="@string/wireguard_public_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="peerPreSharedKey"
            app:title="@string/wireguard_psk" />
        <EditTextPreference
            app:defaultValue="1420"
            app:icon="@drawable/baseline_public_24"
            app:key="mtu"
            app:title="@string/mtu"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="persistentKeepaliveInterval"
            app:title="@string/awg_keepalive"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/awg_cat_junk">
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="junkCount"
            app:title="@string/awg_junk_count"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="junkMin"
            app:title="@string/awg_junk_min"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="junkMax"
            app:title="@string/awg_junk_max"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/awg_cat_paddings">
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="initPadding"
            app:title="@string/awg_s1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="responsePadding"
            app:title="@string/awg_s2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="cookiePadding"
            app:title="@string/awg_s3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="transportPadding"
            app:title="@string/awg_s4"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/awg_cat_headers">
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="initHeader"
            app:title="@string/awg_h1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="responseHeader"
            app:title="@string/awg_h2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="cookieHeader"
            app:title="@string/awg_h3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="transportHeader"
            app:title="@string/awg_h4"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/awg_cat_signatures">
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="signature1"
            app:title="@string/awg_i1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="signature2"
            app:title="@string/awg_i2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="signature3"
            app:title="@string/awg_i3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="signature4"
            app:title="@string/awg_i4"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="signature5"
            app:title="@string/awg_i5"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/awg_cat_advanced">
        <EditTextPreference
            app:icon="@drawable/ic_settings_password"
            app:key="headerProtectionKey"
            app:title="@string/awg_header_protection_key" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="contentPaddingAddition"
            app:title="@string/awg_content_padding"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="randomTrailers"
            app:title="@string/awg_random_trailers" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_info_24"
            app:key="disableCookies"
            app:title="@string/awg_disable_cookies" />
    </PreferenceCategory>

</PreferenceScreen>