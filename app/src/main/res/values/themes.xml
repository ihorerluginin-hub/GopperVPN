<resources>
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <item name="colorAccent">@color/material_pink_accent_200</item>

        <!-- Обновлённый дизайн «Гоппер VPN»: спокойный фон, единые
             поверхности карточек/меню/диалогов, скруглённые карточки.
             Значения цветов переключаются values-night'ом. -->
        <item name="android:windowBackground">@color/gopper_window_bg</item>
        <item name="colorSurface">@color/gopper_surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Gopper.Card</item>
        <item name="popupMenuStyle">@style/Widget.Gopper.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Gopper.ListPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Gopper.PopupMenu.Overflow</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Gopper.MaterialAlertDialog</item>

        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <!-- Текст нижней панели трафика и значки статус-бара.
             Значения по умолчанию рассчитаны на «Гоппер» и другие
             тёмные палитры; светлые темы переопределяют их в своих
             стилях. -->
        <item name="statsBarTextColor">?colorPrimaryDark</item>
        <item name="lightStatusBarIcons">false</item>
        <item name="android:windowLightStatusBar">?attr/lightStatusBarIcons</item>
        <item name="connectingColor">@color/material_pink_400</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <item name="colorAccent">@color/material_pink_accent_200</item>

        <!-- Те же поверхности, что и в базовой теме: диалоговые окна и
             карточки в диалоговых активити выглядят одинаково.
             windowBackground здесь НЕ трогаем: диалоговые активити
             (SwitchActivity) должны оставаться плавающим окном. -->
        <item name="colorSurface">@color/gopper_surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Gopper.Card</item>
        <item name="popupMenuStyle">@style/Widget.Gopper.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Gopper.ListPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Gopper.PopupMenu.Overflow</item>

        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Обновлённый дизайн «Гоппер VPN»: всплывающие меню, диалоги,
         тональные кнопки. Стили общие для всех цветовых тем, сами
         цвета переключаются values-night'ом. -->
    <style name="ShapeAppearance.Gopper.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.Gopper.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_gopper_popup</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="Widget.Gopper.ListPopupMenu" parent="Widget.MaterialComponents.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_gopper_popup</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="Widget.Gopper.PopupMenu.Overflow" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_gopper_popup</item>
    </style>

    <style name="ThemeOverlay.Gopper.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="colorSurface">@color/gopper_surface_elevated</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Gopper.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <style name="ShapeAppearance.Gopper.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!-- Мягкая тональная кнопка: подложка — прозрачный основной цвет
         темы, текст и иконка — тёмный (днём) или акцентный (ночью)
         оттенок той же темы. Используется в ряду под кнопкой
         подключения. Раньше цвета были жёстко зелёными и не следовали
         за выбранной темой. -->
    <style name="Widget.Gopper.TonalButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/tonal_button_text</item>
        <item name="backgroundTint">@color/tonal_button_bg</item>
        <item name="iconTint">@color/tonal_button_text</item>
        <item name="rippleColor">@color/tonal_button_bg</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <!-- Оверлей тулбара для светлых тем (жёлтая, лаймовая и т.д.):
         у них colorPrimary светлый, и белые значки с заголовком на
         таком фоне не читаются. Ставит тёмные значки и текст. -->
    <style name="ThemeOverlay.Gopper.ActionBar.Light" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">#DE000000</item>
        <item name="titleTextColor">#DE000000</item>
        <item name="subtitleTextColor">#99000000</item>
        <item name="colorControlNormal">#B3000000</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
