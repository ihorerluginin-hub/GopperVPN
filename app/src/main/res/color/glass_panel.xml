<?xml version="1.0" encoding="utf-8"?><!--
  Liquid Glass: заливка нижней панели трафика. Размытие делает
  RealtimeBlurView, заливка лишь подкрашивает панель цветом темы —
  поэтому она лёгкая (40%), и содержимое под панелью читается сквозь
  стекло. Ночной вариант плотнее (68%), чтобы тёмный текст не тонул
  в размытом тёмном списке.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.40" android:color="?attr/colorMaterial300" />
</selector>
