<?xml version="1.0" encoding="utf-8"?><!--
  Adaptive icon для Android 8+. Legacy-PNG рисует make_icon.ps1.

  Подложка теперь не сплошной цвет, а тот же градиент, что и в PNG:
  сплошной синий рядом с сине-фиолетовым градиентом выглядел двумя
  разными иконками в одном лаунчере.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>